<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bottom_sheet_background">
    
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New Goal"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/sfpro_bold"
        android:textColor="@color/dark_blue"
        android:layout_marginBottom="20dp"/>
    
    <EditText
        android:id="@+id/etGoalTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Goal Title"
        android:fontFamily="@font/sfpro_reg"
        android:inputType="text"
        android:maxLines="1"
        android:background="@drawable/edit_text_background"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>
    
    <EditText
        android:id="@+id/etGoalDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Description"
        android:fontFamily="@font/sfpro_reg"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:background="@drawable/edit_text_background"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        
        <Button
            android:id="@+id/btnStartDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Set Start Date"
            android:textSize="13sp"
            android:fontFamily="@font/sfpro_reg"
            android:layout_marginEnd="8dp"
            android:background="@drawable/date_button_background"
            android:textColor="@color/dark_blue"
            android:padding="12dp"
            android:elevation="2dp"/>
        
        <Button
            android:id="@+id/btnEndDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Set End Date"
            android:textSize="13sp"
            android:fontFamily="@font/sfpro_reg"
            android:layout_marginStart="8dp"
            android:background="@drawable/date_button_background"
            android:textColor="@color/dark_blue"
            android:padding="12dp"
            android:elevation="2dp"/>
    </LinearLayout>
    
    <TextView
        android:id="@+id/tvDateRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No dates selected"
        android:fontFamily="@font/sfpro_reg"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@color/gray"
        android:padding="8dp"
        android:background="@drawable/date_range_background"
        android:layout_marginBottom="20dp"/>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">
        
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/dark_blue"
            android:fontFamily="@font/sfpro_bold"
            android:background="@android:color/transparent"
            android:layout_marginEnd="8dp"/>
        
        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:fontFamily="@font/sfpro_bold"
            android:textColor="@color/white"
            android:background="@drawable/save_button_background"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"/>
    </LinearLayout>
</LinearLayout>
