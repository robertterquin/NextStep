<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bghome">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_margin="20dp"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/greeting_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/sfpro_bold"
            android:text="Profile"
            android:textColor="@android:color/black"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/user_profile" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginTop="24dp">
        
        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/sfpro_bold"
            android:layout_marginBottom="8dp"/>
            
        <TextView
            android:id="@+id/tvSelectedCareer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Career Path: Not selected"
            android:textSize="16sp"
            android:fontFamily="@font/sfpro_reg"
            android:layout_marginBottom="24dp"/>
            
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="LOG OUT"
            android:textColor="@color/white"
            android:background="@drawable/button_background"
            android:fontFamily="@font/sfpro_bold"/>
    </LinearLayout>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/menubar_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_margin="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_home"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_home" 
                android:contentDescription="Home"/>

            <View
                android:id="@+id/strike_home"
                android:layout_width="40dp"
                android:layout_marginTop="4dp"
                android:layout_height="2dp"
                android:background="#87CEFA"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_tasks"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_task"
                android:contentDescription="Tasks" />

            <View
                android:id="@+id/strike_tasks"
                android:layout_width="40dp"
                android:layout_marginTop="4dp"
                android:layout_height="2dp"
                android:background="#87CEFA"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_goals"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_goals"
                android:contentDescription="Goals" />

            <View
                android:id="@+id/strike_goals"
                android:layout_width="40dp"
                android:layout_marginTop="4dp"
                android:layout_height="2dp"
                android:background="#87CEFA"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_profile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_profile"
                android:contentDescription="Profile" />

            <View
                android:id="@+id/strike_profile"
                android:layout_width="40dp"
                android:layout_marginTop="4dp"
                android:layout_height="2dp"
                android:background="#87CEFA"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
