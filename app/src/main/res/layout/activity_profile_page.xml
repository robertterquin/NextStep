<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bghome">

    <!-- Header Section (Greeting + Notification) -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_margin="20dp">
        <TextView
            android:id="@+id/greeting_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/sfpro_bold"
            android:text="Profile"
            android:textColor="@android:color/black"
            android:textSize="25sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/user_profile"
            app:tint="@color/light_blue" />
    </LinearLayout>

    <!-- Profile Picture + Username Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginTop="24dp">

        <!-- Profile Picture ImageView -->
        <ImageView
            android:id="@+id/profile_picture"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Profile Picture"
            android:layout_gravity="center"
            android:src="@drawable/empty_profile"
            android:scaleType="centerCrop" />

        <!-- Username TextView -->
        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/sfpro_bold"
            android:layout_marginBottom="8dp"/>

        <!-- Career Path TextView -->
        <TextView
            android:id="@+id/tvSelectedCareer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Career Path: Not selected"
            android:textSize="16sp"
            android:fontFamily="@font/sfpro_reg"
            android:layout_marginBottom="24dp"/>

        <!-- Log Out Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="LOG OUT"
            android:textColor="@color/white"
            android:background="@drawable/button_background"
            android:fontFamily="@font/sfpro_bold"/>
    </LinearLayout>

    <!-- Placeholder View (for any additional spacing if needed) -->

    <!-- Bottom Navigation Section -->
    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/menubar_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_margin="20dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_home"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_home"
                android:contentDescription="Home" />

            <View
                android:id="@+id/strike_home"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#5BC3EC"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_tasks"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_task"
                android:contentDescription="Tasks" />

            <View
                android:id="@+id/strike_tasks"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#5BC3EC"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_goals"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_goals"
                android:contentDescription="Goals" />

            <View
                android:id="@+id/strike_goals"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#5BC3EC"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_profile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_profile"
                android:contentDescription="Profile" />

            <View
                android:id="@+id/strike_profile"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#5BC3EC"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
