<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bghome">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_margin="20dp"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/greeting_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/sfpro_bold"
            android:text="Your Goals"
            android:textColor="@android:color/black"
            android:textSize="25sp"
            android:textStyle="bold" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_input_add"
            app:fabSize="mini"
            android:background="@color/light_blue"
            app:tint="@color/white"
            android:contentDescription="Add new goal"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp">
        
        <TextView
            android:id="@+id/tvActiveGoals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Goals"
            android:textSize="16sp"
            android:fontFamily="@font/sfpro_bold"
            android:textColor="@color/black"
            android:paddingVertical="10dp"
            android:paddingHorizontal="15dp"
            android:background="@drawable/selected_tab_bg"
            android:layout_marginEnd="10dp"/>
            
        <TextView
            android:id="@+id/tvCompletedGoals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completed"
            android:textSize="16sp"
            android:fontFamily="@font/sfpro_bold"
            android:textColor="@color/gray"
            android:paddingVertical="10dp"
            android:paddingHorizontal="15dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/goalsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@color/light_blue"
        android:scrollbarSize="4dp"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls" />

    <TextView
        android:id="@+id/tvNoGoals"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No goals yet. Tap the + button to add a new goal."
        android:gravity="center"
        android:textColor="@color/gray"
        android:fontFamily="@font/sfpro_reg"
        android:visibility="gone"
        android:layout_marginHorizontal="20dp"/>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/menubar_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_margin="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_home"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Home"
                android:src="@drawable/icon_home" />

            <View
                android:id="@+id/strike_home"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#5BC3EC"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_tasks"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Tasks"
                android:src="@drawable/icon_task" />

            <View
                android:id="@+id/strike_tasks"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#5BC3EC"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_goals"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Goals"
                android:src="@drawable/icon_goals" />

            <View
                android:id="@+id/strike_goals"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#5BC3EC"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/nav_profile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Profile"
                android:src="@drawable/icon_profile" />

            <View
                android:id="@+id/strike_profile"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#5BC3EC"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
